    IDS_ERR_PATH_NOT_FOUND_FMT      "Windows can't find '%1'. Check the spelling and try again."
    IDS_ERR_LOCATION_FMT            "Can't open '%1': %2"
    IDS_ERR_CANT_OPEN_TITLE         "Windows can't open this file"
    IDS_ERR_CANT_OPEN_BODY_FMT      "No app is associated with '%1'. Choose an app to open it."
    IDS_CMD_OPEN_WITH               "Open with…"
    IDS_OP_COPYING_FMT              "Copying %1!u! items…"
    IDS_OP_MOVING_FMT               "Moving %1!u! items…"
    IDS_OP_DELETING_FMT             "Deleting %1!u! items…"
    IDS_OP_RENAMING                 "Renaming…"
    IDS_OP_COPIED_FMT               "%1!u! items copied"
    IDS_OP_MOVED_FMT                "%1!u! items moved"
    IDS_OP_DELETED_FMT              "%1!u! items deleted"
    IDS_OP_RENAMED                  "Item renamed"
    IDS_OP_PARTIAL_FMT              "%1!u! of %2!u! items completed"
    IDS_OP_CANCELLED_FMT            "Operation cancelled — %1!u! items completed before cancellation"
    IDS_OP_FAILED_TITLE             "Some items couldn't be processed"
    IDS_OP_FAILED_ITEM_FMT          "%1: %2"
    IDS_ERR_INVALID_NAME            "A file name can't contain any of the following characters: \\ / : * ? "" < > |"
    IDS_SETTINGS_RESET              "Appearance settings were reset"
    IDS_A11Y_PICKER_NAME            "Appearance and color"
    IDS_A11Y_FILE_LIST              "Items"
    IDS_A11Y_TOOLBAR                "Navigation"
    IDS_A11Y_ADDRESS                "Address"
    IDS_A11Y_NAV_PANE               "Navigation pane"
    IDS_A11Y_RENAME                 "Name"
    IDS_FILTER_PLACEHOLDER          "Filter"
END
