{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings: MSVC x64, vcpkg manifest mode. Run from a Developer PowerShell for Visual Studio, which sets VCPKG_ROOT.",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (Visual Studio 2026)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (Visual Studio 2026)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vs2022-x64-debug",
      "displayName": "x64 Debug (Visual Studio 2022)",
      "inherits": "x64-debug",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2022-x64-release",
      "displayName": "x64 Release (Visual Studio 2022)",
      "inherits": "x64-release",
      "generator": "Visual Studio 17 2022"
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "vs2022-x64-debug", "configurePreset": "vs2022-x64-debug", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "configurePreset": "vs2022-x64-release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "x64-debug", "inherits": "test-base", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "inherits": "test-base", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "vs2022-x64-debug", "inherits": "test-base", "configurePreset": "vs2022-x64-debug", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "inherits": "test-base", "configurePreset": "vs2022-x64-release", "configuration": "Release" }
  ]
}
